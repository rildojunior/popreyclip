<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PoPreyClip</RootNamespace>
    <NoWarn>$(NoWarn);SYSLIB1054;SYSLIB1096;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoPreyClip.Tests" />
    <InternalsVisibleTo Include="PoPreyClip.Cli" />
    <InternalsVisibleTo Include="PoPreyClip" />
  </ItemGroup>

  <!--
    Voice command: Whisper (whisper.cpp, MIT) through Whisper.net. Only the 64-bit Windows CPU libraries (about 2 MB)
    go inside the app, as embedded files written to %LOCALAPPDATA%\PoPreyClip\voz\lib when the voice command is
    used; the speech model is downloaded at that moment (see Voice\VoiceAddon.cs).
  -->
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageDownload Include="Whisper.net.Runtime" Version="[1.9.1]" />
    <EmbeddedResource Include="$(NuGetPackageRoot)whisper.net.runtime\1.9.1\build\win-x64\*.dll"
                      LogicalName="whisper\%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
