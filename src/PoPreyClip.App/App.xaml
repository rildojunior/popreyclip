<Application x:Class="PoPreyClip.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PoPreyClip.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:EnumEqualsConverter x:Key="EnumEquals" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <local:InvertBoolConverter x:Key="InvertBool" />
            <local:ColumnsForWidthConverter x:Key="ColumnsForWidth" />
            <local:ScaleConverter x:Key="Scale" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
