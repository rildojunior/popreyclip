<UserControl x:Class="PoPreyClip.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PoPreyClip.App.Controls">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,16" />
        </Style>
        <Style TargetType="controls:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="240" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,4,36,36" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource TitleText}" />
            <TextBlock Text="As alterações são salvas automaticamente." Style="{StaticResource SubtitleText}" Margin="0,4,0,24" />

            <!-- Folder -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Pasta dos clipes" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Pasta raiz onde os clipes são salvos. Dentro dela fica a pasta Clips, com uma subpasta para cada jogo."
                               Style="{StaticResource HintText}" Margin="0,6,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ClipFolderText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyFolderCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock Text="Alterar pasta" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Content="Abrir" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
                    </Grid>
                    <TextBlock Text="Digite um caminho e pressione Enter, ou use Alterar pasta." Style="{StaticResource HintText}" Margin="0,8,0,0" />
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Exemplo de clipe salvo" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBlock Text="{Binding FolderExample}" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Teclas de atalho" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Clique no campo e pressione a combinação de teclas. Funcionam mesmo dentro do jogo. Esc cancela."
                               Style="{StaticResource HintText}" Margin="0,6,0,16" />

                    <DockPanel>
                        <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding SaveClipHotkey, Mode=TwoWay}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Salvar clipe" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Salva os últimos segundos gravados." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding SaveHotkeyError}" Foreground="{StaticResource DangerBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding SaveHotkeyError, Converter={StaticResource NotEmptyToVisibility}}" />

                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding ToggleRecordingHotkey, Mode=TwoWay}" AllowEmpty="True" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Iniciar ou parar gravação" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Opcional. Backspace remove o atalho." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ToggleHotkeyError}" Foreground="{StaticResource DangerBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ToggleHotkeyError, Converter={StaticResource NotEmptyToVisibility}}" />

                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding ScreenshotHotkey, Mode=TwoWay}" AllowEmpty="True" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Capturar tela" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Salva uma imagem PNG da tela. Funciona mesmo com a gravação parada. Backspace remove o atalho." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ScreenshotHotkeyError}" Foreground="{StaticResource DangerBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ScreenshotHotkeyError, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Screenshots -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Capturas de tela" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="As capturas ficam na pasta Screenshots, com uma subpasta para cada jogo, igual aos clipes."
                               Style="{StaticResource HintText}" Margin="0,6,0,12" />
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,10">
                        <TextBlock Text="{Binding ScreenshotFolderExample}" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Border>
                    <DockPanel Margin="0,16,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CopyScreenshotToClipboard}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Copiar para a área de transferência" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Depois é só colar (Ctrl+V) no Discord ou em qualquer conversa." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PlaySoundOnScreenshot}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Som de câmera ao capturar" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Usa o mesmo volume do aviso de clipe." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Clip -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Duração do clipe" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Quanto tempo antes do atalho entra no clipe." Style="{StaticResource HintText}" Margin="0,6,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="15"
                                Value="{Binding ClipSeconds, Mode=TwoWay, Delay=150}" />
                        <TextBlock Grid.Column="1" Text="{Binding ClipSecondsText}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Clip saved sound -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PlaySoundOnClip}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Som ao salvar clipe" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Toca quando um clipe termina de ser salvo, mesmo com a janela fechada." Style="{StaticResource HintText}" Margin="0,6,0,16" />

                    <StackPanel IsEnabled="{Binding PlaySoundOnClip}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox Width="250" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding Sound}" DisplayMemberPath="Label" />
                                <Button Margin="8,0,0,0" Command="{Binding PreviewSoundCommand}" ToolTip="Ouvir">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Ouvir" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Style="{StaticResource RowLabel}">
                                <TextBlock Text="Som" Style="{StaticResource LabelText}" />
                                <TextBlock Text="Escolha um som e ele toca na hora para você ouvir." Style="{StaticResource HintText}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,12,0,0" Visibility="{Binding IsCustomSound, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="Escolher arquivo..." Command="{Binding BrowseSoundCommand}" />
                            <TextBlock Text="{Binding CustomSoundName}" Style="{StaticResource HintText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Border Style="{StaticResource Divider}" />
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="330">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolume, Mode=TwoWay, Delay=150}" IsSnapToTickEnabled="True" TickFrequency="5" />
                                <TextBlock Grid.Column="1" Text="{Binding SoundVolumeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Style="{StaticResource RowLabel}">
                                <TextBlock Text="Volume do aviso" Style="{StaticResource LabelText}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Video -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Vídeo" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Mudanças de vídeo reiniciam a gravação." Style="{StaticResource HintText}" Margin="0,6,0,16" />

                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding CaptureOptions}" SelectedItem="{Binding Capture}" DisplayMemberPath="Label" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="O que gravar" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Só a janela do jogo: outras janelas, alt-tab e a área de trabalho não aparecem no clipe. Sem jogo aberto, grava o monitor. Se um jogo sair preto ou parado, escolha Monitor inteiro." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding EncoderOptions}" SelectedItem="{Binding Encoder}" DisplayMemberPath="Label" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Codificador" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Use o da sua placa de vídeo para não pesar no jogo." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" DisplayMemberPath="Label" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Quadros por segundo" Style="{StaticResource LabelText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor}" DisplayMemberPath="Label" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Monitor gravado" Style="{StaticResource LabelText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="12" Maximum="37" Value="{Binding Quality, Mode=TwoWay, Delay=200}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </Grid>
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Qualidade" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding QualityText}" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCursor}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Mostrar o cursor do mouse" Style="{StaticResource LabelText}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Comportamento" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <DockPanel Margin="0,16,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRecordGames}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Gravar só quando um jogo estiver aberto" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Fora do jogo o app fica em espera, sem gastar recursos. A gravação liga sozinha quando um jogo ou app vigiado abrir e desliga quando ele fechar." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel IsEnabled="{Binding CanChooseStartOnLaunch}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartRecordingOnLaunch}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Começar a gravar ao abrir" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Só vale com a opção acima desligada." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Iniciar com o Windows" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Abre sozinho ao ligar o PC, já escondido na bandeja." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Continuar na bandeja ao fechar a janela" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Para sair de verdade, use Sair no ícone da bandeja." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DetectFullscreenApps}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Detectar jogos em tela cheia" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Qualquer programa em tela cheia ou janela sem borda conta como jogo." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Watched games and apps -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Watched}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Jogos e apps vigiados" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Programas desta lista contam como jogo assim que abrem, mesmo fora da tela cheia. Use para jogos que não são detectados sozinhos ou para qualquer app que você queira gravar."
                               Style="{StaticResource HintText}" Margin="0,6,0,14" />

                    <!-- Add from an open window -->
                    <TextBlock Text="Adicionar uma janela aberta" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding OpenWindows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Display" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Command="{Binding RefreshWindowsCommand}" ToolTip="Atualizar a lista de janelas" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome do jogo" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Também é o nome da pasta dos clipes" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Vigiar" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Carregando janelas..." Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Current list -->
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="Nenhum programa vigiado ainda." Style="{StaticResource HintText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}"
                                                ToolTip="Parar de vigiar" Width="30" Height="30" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExeName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Atualizações" Style="{StaticResource SectionText}" Margin="12,0,0,0" />
                    </StackPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding Updates.CheckNowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Procurar agora" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="{Binding Updates.CurrentVersionText}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource HintText}"
                                       Visibility="{Binding Updates.Status, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.AutoCheck}" />
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="Procurar atualizações automaticamente" Style="{StaticResource LabelText}" />
                            <TextBlock Text="Ao abrir e a cada 6 horas. Quando sair uma versão nova, aparece um aviso para atualizar com um clique." Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding Updates.OpenChangelogCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Novidades" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0" Command="{Binding Updates.OpenRepositoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Abrir no GitHub" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Style="{StaticResource RowLabel}">
                            <TextBlock Text="PoPreyClip no GitHub" Style="{StaticResource LabelText}" />
                            <TextBlock Text="O que mudou em cada versão, o guia de instalação e uso, e onde avisar de problemas." Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding Updates.RepositoryText}" Style="{StaticResource HintText}" FontFamily="Consolas" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Abrir configuração" Command="{Binding OpenConfigFileCommand}" />
                        <Button Content="Abrir logs" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource RowLabel}">
                        <TextBlock Text="Avançado" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource HintText}" FontFamily="Consolas" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
