<UserControl x:Class="PoPreyClip.App.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,4,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,16,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid Width="220">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextFaintBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Buscar clipes" Foreground="{StaticResource TextFaintBrush}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Search, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
                </Grid>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Atualizar" />
                <Button Margin="8,0,0,0" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding CanOpenGameFolder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="Pasta do jogo" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding OpenRootCommand}" ToolTip="{Binding RootPath}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="Abrir pasta" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Clipes" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Game filter -->
        <DockPanel Grid.Row="1" Margin="0,0,16,16">
                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,14,6" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="kind" Content="Tudo"
                                     IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="kind" Content="Vídeos"
                                     IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Videos}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="kind" Content="Capturas"
                                     IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Screenshots}" />
                    </StackPanel>
                </Border>
        <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" VerticalAlignment="Center"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ChipItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Count}" FontSize="12" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>

        <!-- Grid of clips -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ClipGrid" ItemsSource="{Binding Clips}" Margin="0,0,0,28">
                <!-- As many columns as fit with cards at least 280 px wide (+16 px gap); the cards stretch to fill the row. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top"
                                     Columns="{Binding ActualWidth, ElementName=ClipGrid, Converter={StaticResource ColumnsForWidth}, ConverterParameter=296}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Margin="0,0,16,16" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid Height="{Binding ActualWidth, ElementName=Card, Converter={StaticResource Scale}, ConverterParameter=0.5625}">
                                    <Border CornerRadius="12,12,0,0" Background="{StaticResource Surface2Brush}">
                                        <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" Foreground="{StaticResource TextFaintBrush}" FontSize="28" />
                                    </Border>
                                    <Border CornerRadius="12,12,0,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Button x:Name="PlayOverlay" Command="{Binding PlayCommand}" Cursor="Hand" Opacity="0" ToolTip="{Binding OpenText}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12,12,0,0" Background="#66000000">
                                                    <Border Width="52" Height="52" CornerRadius="26" Background="#E6FFFFFF">
                                                        <TextBlock Text="{Binding OpenIcon}" Style="{StaticResource IconText}" Foreground="#111" FontSize="20" Margin="3,0,0,0" />
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="7,2" CornerRadius="4" Background="#B0000000"
                                            IsHitTestVisible="False" Visibility="{Binding DurationText, Converter={StaticResource NotEmptyToVisibility}}">
                                        <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="7,2" CornerRadius="4" Background="#B0000000"
                                            IsHitTestVisible="False" Visibility="{Binding IsScreenshot, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="Captura" FontSize="11.5" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="14,12,14,14">
                                    <TextBlock Text="{Binding Game}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,12">
                                        <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" Padding="8,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OpenIcon}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding OpenText}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding EditCommand}" Padding="10,7" Margin="6,0,0,0" ToolTip="Cortar, recortar a imagem e ajustar o áudio"
                                                Visibility="{Binding IsScreenshot, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Editar" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE838;" Width="32" Margin="4,0,0,0" Command="{Binding RevealCommand}" ToolTip="Mostrar na pasta" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="32" Margin="2,0,0,0" Command="{Binding DeleteCommand}" ToolTip="Mover para a Lixeira" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PlayOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource TextFaintBrush}" />
            </Border>
            <TextBlock Text="Nenhum clipe encontrado" Style="{StaticResource SectionText}" HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock Text="Os clipes salvos aparecem aqui, separados por jogo." Style="{StaticResource HintText}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
