<Window x:Class="PoPreyClip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PoPreyClip.App.Views"
        xmlns:app="clr-namespace:PoPreyClip.App"
        Title="PoPreyClip" Width="1200" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource BackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,18">
                <!-- Brand lockup from the identity kit: the hunter's eye (white ring, lavender iris like "Clip") and the wordmark -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,28">
                    <Viewbox Width="30" Height="30" VerticalAlignment="Center">
                        <Canvas Width="256" Height="256">
                            <Path Fill="White" Data="F0 M240,128 A112,112 0 1 1 16,128 A112,112 0 1 1 240,128 Z M216,128 A88,88 0 1 1 40,128 A88,88 0 1 1 216,128 Z" />
                            <Path Fill="{StaticResource AccentTextBrush}" Data="F0 M188,128 A60,60 0 1 1 68,128 A60,60 0 1 1 188,128 Z M128,76 A92.5,92.5 0 0 1 128,180 A92.5,92.5 0 0 1 128,76 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontSize="19">
                        <Run Text="PoPrey" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Foreground="White" /><Run Text="Clip" FontFamily="{StaticResource SectionFont}" Foreground="{StaticResource AccentTextBrush}" />
                    </TextBlock>
                </StackPanel>

                <!-- Recording status -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="Pulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding StatusTitle}" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentGame}" Margin="22,4,0,12" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <Button Command="{Binding ToggleRecordingCommand}" HorizontalAlignment="Stretch"
                                ToolTip="{Binding ToggleToolTip}" ToolTipService.ShowDuration="20000">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding ToggleText}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SaveClipCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Style="{StaticResource DangerButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Salvar clipe" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;" Content="Início" IsChecked="{Binding IsHomePage}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE767;" Content="Áudio" IsChecked="{Binding IsAudioPage}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE714;" Content="Clipes" IsChecked="{Binding IsClipsPage}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;" Content="Configurações" IsChecked="{Binding IsSettingsPage}" />

                    <!-- Settings groups: a click scrolls the settings page to the group -->
                    <ItemsControl ItemsSource="{Binding Settings.Sections}" Margin="0,2,0,0" app:Motion.EnterOffset="-4"
                                  Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding GoCommand}" AutomationProperties.Name="{Binding Title}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="44,6,10,6">
                                                <Grid>
                                                    <Border x:Name="Indicator" Width="2" Height="14" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                                            HorizontalAlignment="Left" Margin="-14,0,0,0" Visibility="Collapsed" />
                                                    <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar" />
            </StackPanel>

            <StackPanel Grid.Row="1">
            <!-- Update banner -->
            <Border Margin="36,0,36,12" Padding="14,10" CornerRadius="10" app:Motion.EnterOffset="-6"
                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ver novidades" Command="{Binding Updates.OpenReleasePageCommand}" Padding="12,6" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding Updates.InstallCommand}" Padding="12,6" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Updates.InstallText}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding Updates.DismissCommand}" Width="28" Height="28" Margin="6,0,0,0" ToolTip="Lembrar depois" />
                    </StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentTextBrush}" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updates.AvailableText}" FontWeight="SemiBold" />
                        <TextBlock Text="O app baixa a versão nova e reinicia sozinho em alguns segundos." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Error banner -->
            <Border Margin="36,0,36,12" Padding="14,10" CornerRadius="10" app:Motion.EnterOffset="-6"
                    Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissErrorCommand}" Width="28" Height="28" />
                    <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DangerBrush}" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Abrir pasta do log" Command="{Binding OpenLogFolderCommand}" Padding="12,6"
                                    ToolTip="Os detalhes técnicos do erro ficam no arquivo de log. Envie-o para reportar o problema." />
                            <Button Content="Reiniciar o app" Command="{Binding RestartAppCommand}" Padding="12,6" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <views:HomeView app:Motion.EnterOffset="8" Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibility}}" />
                <views:AudioView app:Motion.EnterOffset="8" DataContext="{Binding Audio}"
                                 Visibility="{Binding DataContext.IsAudioPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:ClipsView app:Motion.EnterOffset="8" DataContext="{Binding Clips}"
                                 Visibility="{Binding DataContext.IsClipsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsView app:Motion.EnterOffset="8" DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Clip saved toast -->
            <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Padding="16,12" app:Motion.EnterOffset="12"
                    CornerRadius="12" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                    </Border>
                    <TextBlock Text="{Binding ToastMessage}" Margin="12,0,18,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="Assistir" Command="{Binding ToastOpenCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Visibility="{Binding HasToastActions, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Mostrar na pasta" Command="{Binding ToastRevealCommand}" Margin="8,0,0,0" Padding="12,6"
                            Visibility="{Binding HasToastActions, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseToastCommand}" Margin="6,0,0,0" Width="28" Height="28" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
