<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PoPreyClip.App</RootNamespace>
    <AssemblyName>PoPreyClip</AssemblyName>
    <!-- App version. The release script passes -p:Version=X.Y.Z; keep this in sync with the latest release. -->
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>PoPreyClip</Product>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both define Application, MessageBox, etc. Only WPF is imported globally. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <!-- Sora (SIL Open Font License, see Assets\Fonts\Sora-OFL.txt): titles and the wordmark. -->
    <Resource Include="Assets\Fonts\Sora-500.ttf" />
    <Resource Include="Assets\Fonts\Sora-700.ttf" />
    <None Include="Assets\Fonts\Sora-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PoPreyClip.Core/PoPreyClip.Core.csproj" />
  </ItemGroup>

</Project>
